# Copy to .env and fill MODEL_API_KEY. Never commit a real key.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# Render: fill MODEL_API_KEY and DEMO_CODE in the service Environment page.
# This private code unlocks live API calls in the public preview only.
DEMO_CODE=
# Only when running outside Docker with a manually prepared toolchain:
# TERRAFORM_BIN=/absolute/path/to/terraform
# TERRAFORM_MIRROR=/absolute/path/to/terraform-mirror
# TERRAFORM_LOCK_FILE=/absolute/path/to/.terraform.lock.hcl
