terraform {
  required_version = "= 1.9.8"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "= 5.100.0"
    }
  }
}
provider "aws" {
  region = "{{ target.region }}"
  default_tags {
    tags = {
      Project          = "{{ target.name }}"
      ApprovedRevision = "{{ revision }}"
    }
  }
}
